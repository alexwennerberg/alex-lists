def connect():
    path = os.environ.get("SRHT_CONFIG", "config.ini")
    parser = configparser.ConfigParser(strict=False)
    parser.read(path)
    conn = psycopg2.connect(parser["lists.sr.ht"]["connection-string"])
    conn.autocommit = True
    return conn


def sql(conn, statement):
    with conn.cursor() as cur:
        cur.execute(statement)
        if cur.description is None:
            return None
        return [tuple(row) for row in cur.fetchall()]


def session_for(persona, base):
    """A logged-in session, or an anonymous one. See contrib/golden."""
    session = requests.Session()
    if persona == "anon":
        return session
    page = session.get(f"{base}/login", timeout=30)
    token = re.search(r"name='_csrf_token'\s+value='([0-9a-f]+)'", page.text)
    if not token:
        sys.exit(f"no CSRF token on {base}/login")
    session.post(f"{base}/login", timeout=30, data={
        "username": persona, "_csrf_token": token.group(1)})
    host = urlparse(base).hostname
    home = host if "." in host else host + ".local"
    for cookie in list(session.cookies):
        if cookie.domain != home:
            session.cookies.clear(cookie.domain, cookie.path, cookie.name)
            session.cookies.set(cookie.name, cookie.value, domain=home, path="/")
    return session


def csrf_from(session, base, url):
    """The token the form on this page carries."""
    page = session.get(base + url, timeout=30)
    token = re.search(r"name='_csrf_token'\s+value='([0-9a-f]+)'", page.text)
    if not token:                     # not a page: fall back to the index
        page = session.get(base + "/", timeout=30)
        token = re.search(r"name='_csrf_token'\s+value='([0-9a-f]+)'", page.text)
    return token.group(1) if token else ""


def run(case, base, conn):
    """One submission, from a freshly reset state. Returns what to compare."""
    sql(conn, case["reset"])
    if case.get("before"):
        sql(conn, case["before"])

    session = session_for(case["as"], base)
    form = dict(case.get("form") or {})
    form["_csrf_token"] = csrf_from(
        session, base, case.get("csrf_page", case["url"]))
    response = session.post(base + case["url"], data=form, timeout=60,
                            allow_redirects=False)
    state = sql(conn, case["state"])
    sql(conn, case["reset"])
    return {
        "status": response.status_code,
        "location": response.headers.get("location", ""),
        "state": state,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__,
            formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--filter", default="")
    parser.add_argument("--python", default=PYTHON)
    parser.add_argument("--go", default=GO)
    args = parser.parse_args()

    conn = connect()
    cases = [c for c in CASES if args.filter in c["name"]]
    if not cases:
        sys.exit(f"no cases match {args.filter!r}")

    failures = 0
    for case in cases:
        want = run(case, args.python, conn)
        got = run(case, args.go, conn)
        if want == got:
            print(f"ok    {case['name']}")
            continue
        failures += 1
        print(f"FAIL  {case['name']}")
        for key in ("status", "location", "state"):
            if want[key] != got[key]:
                print(f"        {key}: python {want[key]!r}")
                print(f"        {' ' * len(key)}  go     {got[key]!r}")

    print(f"\n{len(cases) - failures}/{len(cases)} cases match")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
