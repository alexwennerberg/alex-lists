#!/usr/bin/env python3
"""
Differential test for the POST handlers.

    contrib/mutations                    # every case, both apps
    contrib/mutations --filter subscribe

contrib/golden compares what the two apps *render*; this compares what they
*write*. Each case is submitted to the Python app and then, from the same
starting state, to the Go app, and the two are held to the same response and
the same resulting rows.

Cases restore the database themselves, so the golden fixtures stay valid: a
case that leaves anything behind will show up as the next capture drifting.
"""

import argparse
import configparser
import os
import re
import sys
from urllib.parse import urlparse

import psycopg2
import requests

PYTHON = "http://localhost:5006"
GO = "http://localhost:5007"

# Each case: who submits it, where, with what, a query describing the state it
# is supposed to change, and SQL putting that state back.
CASES = [
    {
        "name": "subscribe",
        "csrf_page": "/~alex/devel",
        "as": "newperson",
        "url": "/~alex/devel/subscribe",
        "state": """SELECT u.username FROM subscription s
                    JOIN "user" u ON u.id = s.user_id
                    JOIN list l ON l.id = s.list_id
                    WHERE l.name = 'devel' ORDER BY u.username""",
        "reset": """DELETE FROM subscription s USING "user" u, list l
                    WHERE s.user_id = u.id AND s.list_id = l.id
                    AND u.username = 'newperson' AND l.name = 'devel'""",
    },
    {
        "name": "subscribe-twice",
        "csrf_page": "/~alex/devel",
        "as": "newperson",
        "url": "/~alex/devel/subscribe",
        "before": """INSERT INTO subscription (created, updated, user_id, list_id)
                     SELECT NOW(), NOW(), u.id, l.id FROM "user" u, list l
                     WHERE u.username = 'newperson' AND l.name = 'devel'""",
        "state": """SELECT count(*) FROM subscription s
                    JOIN "user" u ON u.id = s.user_id
                    JOIN list l ON l.id = s.list_id
                    WHERE u.username = 'newperson' AND l.name = 'devel'""",
        "reset": """DELETE FROM subscription s USING "user" u, list l
                    WHERE s.user_id = u.id AND s.list_id = l.id
                    AND u.username = 'newperson' AND l.name = 'devel'""",
    },
    {
        "name": "unsubscribe",
        "csrf_page": "/~alex/devel",
        "as": "newperson",
        "url": "/~alex/devel/unsubscribe",
        "before": """INSERT INTO subscription (created, updated, user_id, list_id)
                     SELECT NOW(), NOW(), u.id, l.id FROM "user" u, list l
                     WHERE u.username = 'newperson' AND l.name = 'devel'""",
        "state": """SELECT count(*) FROM subscription s
                    JOIN "user" u ON u.id = s.user_id
                    JOIN list l ON l.id = s.list_id
                    WHERE u.username = 'newperson' AND l.name = 'devel'""",
        "reset": """DELETE FROM subscription s USING "user" u, list l
                    WHERE s.user_id = u.id AND s.list_id = l.id
                    AND u.username = 'newperson' AND l.name = 'devel'""",
    },
    {
        "name": "subscribe-anonymous",
        "csrf_page": "/~alex/devel",
        "as": "anon",
        "url": "/~alex/devel/subscribe",
        "state": "SELECT count(*) FROM subscription",
        "reset": "SELECT 1",
    },
    {
        "name": "settings-info",
        "as": "alex",
        "url": "/~alex/adsf/settings/info",
        "form": {"visibility": "PUBLIC", "description": "a new description"},
        "state": """SELECT name, description, visibility FROM list
                    WHERE name = 'adsf'""",
        "reset": """UPDATE list SET description = 'asdf' WHERE name = 'adsf'""",
    },
    {
        "name": "settings-info-not-owner",
        "as": "newperson",
        "url": "/~alex/adsf/settings/info",
        "form": {"visibility": "PUBLIC", "description": "hijacked"},
        "state": """SELECT name, description, visibility FROM list
                    WHERE name = 'adsf'""",
